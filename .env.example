# Claude Console(platform.claude.com) → Settings → API keys 에서 발급
# 이 파일을 .env로 복사한 뒤 실제 키를 넣으세요. .env는 git에 올라가지 않습니다.
ANTHROPIC_API_KEY=sk-ant-여기에키

# 모델명은 설정값으로 분리 (코드 수정 없이 교체)
CLASSIFIER_MODEL=claude-haiku-5-5
ANSWER_MODEL=claude-sonnet-5-5

# RAG 프로토타입 (src/rag_prototype) 실험 파라미터
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=400
CHUNK_OVERLAP=100
TOP_K=3
SEARCH_TYPE=similarity
PROMPT_VERSION=v3.1
SPLIT_MODE=merged

# 리랭커 (true로 켜면 임베딩 상위 RERANK_FETCH_K개를 다시 정렬해 TOP_K개 사용)
RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_FETCH_K=20
